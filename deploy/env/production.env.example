# Elasticsearch
ELASTICSEARCH_URL=https://elk-prod.exemplo.intra:9200
ELASTICSEARCH_USERNAME=elastic
ELASTIC_PASSWORD=troque-esta-senha
ELASTICSEARCH_INDEX=github-workflows*
ELASTICSEARCH_VERIFY_SSL=true

# Agent
AGENT_PROVIDER=openai_compatible
LLM_API_BASE=https://llm-gateway.exemplo.intra/v1
LLM_MODEL=qwen2.5-72b-instruct
LLM_API_KEY=
LLM_AUTH_HEADER=Authorization
LLM_AUTH_SCHEME=Bearer

# Laboratório / fallback
OLLAMA_API_BASE=http://ollama-prod.exemplo.intra:11434
OLLAMA_MODEL=qwen2.5:7b

# Opcional
GROQ_API_KEY=
